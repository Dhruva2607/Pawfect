# ──────────────────────────────────────────────
# PawFect - AI Pet Matchmaker
# Environment Variables (Backend)
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real secrets.
# ──────────────────────────────────────────────

# Google Gemini API key (chat and 768-dimensional embedding generation)
GOOGLE_API_KEY=your-google-ai-studio-api-key

# MongoDB connection string (local MongoDB default; Atlas example)
MONGODB_URI=mongodb://localhost:27017
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# MongoDB database name
DATABASE_NAME=pawfect

# Comma-separated list of allowed CORS origins ("*" for local development)
ALLOWED_ORIGINS=*
