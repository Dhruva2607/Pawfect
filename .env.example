# ──────────────────────────────────────────────
# PawFect - AI Pet Matchmaker
# Environment Variables
# ──────────────────────────────────────────────
# The backend reads backend/.env. Copy the backend template there:
#   Copy-Item backend\.env.example backend\.env
# NEVER commit .env files containing real secrets.
# ──────────────────────────────────────────────

# Google Gemini API key (chat, embeddings, AI evaluations)
GOOGLE_API_KEY=

# MongoDB connection string
MONGODB_URI=

# MongoDB database name
DATABASE_NAME=pawfect

# Comma-separated allowed CORS origins ("*" for local development)
ALLOWED_ORIGINS=*
